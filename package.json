{
  "name": "report",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch scripts/dev.cjs",
    "start": "node server.js",
    "bitrix:check": "node scripts/bitrix-check.cjs",
    "test:crm-performance": "node scripts/report-performance.cjs",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:unit:watch": "jest --selectProjects unit --watchAll",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:ci": "jest --ci --runInBand",
    "test:install": "playwright install chromium",
    "build": "vite build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.10",
    "jest": "30.5.2",
    "playwright": "1.64.1",
    "serve-handler": "6.1.7",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "vue": "3.5.44",
    "express": "4.22.3",
    "google-auth-library": "10.9.1",
    "helmet": "8.1.0",
    "otplib": "12.0.1",
    "qrcode": "1.5.4"
  }
}
