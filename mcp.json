{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--chromeArg=--guest",
        "--chromeArg=--new-window"
      ],
      "directTools": true
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "directTools": true
    }
  }
}
