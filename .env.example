# Базовый HTTPS URL входящего вебхука Битрикс24, без имени REST-метода.
# Вставьте значение только в локальный .env. Не добавляйте секрет в Git.
BITRIX24_WEBHOOK_URL=

# Вход через Google и Authenticator. Все четыре переменные заполняются вместе:
# пустая группа отключает авторизацию, частичная настройка не даёт серверу
# запуститься. В production авторизация обязательна.

# Точный публичный источник браузера, без слеша в конце.
PUBLIC_ORIGIN=

# Client ID веб-приложения Google Identity Services.
# В Google Cloud Console добавьте PUBLIC_ORIGIN в Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Отдельный секрет шифрования локальных привязок Authenticator, не менее 32 символов.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_SECRET=

# Только эти подтверждённые аккаунты Google могут входить, через запятую.
GOOGLE_ALLOWED_EMAILS=
